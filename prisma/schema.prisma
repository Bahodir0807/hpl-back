  nameEn      String
  description String?
  unit        InstallationWorkUnit
  category    InstallationWorkCategory @default(OTHER)
  isActive    Boolean                  @default(true)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  rates               InstallationContractorRate[]
  calculationItems    InstallationCalculationItem[]

