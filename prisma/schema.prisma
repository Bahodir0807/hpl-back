model InstallationCalculation {
  id           String                        @id @default(uuid())
  leadId       String                        @unique
  assignmentId String?
  engineerId   String
  status       InstallationCalculationStatus @default(DRAFT)
  revision     Int                           @default(1)
  note         String?
