  updatedAt    DateTime                      @updatedAt

  lead       Lead                        @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignment LeadEngineeringAssignment?  @relation(fields: [assignmentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  engineer   User                        @relation("InstallationCalculationEngineer", fields: [engineerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items      InstallationCalculationItem[]
  revisions  InstallationCalculationRevision[]
  commercialCalculations InstallationCommercialCalculation[]

  @@index([engineerId])
  @@index([assignmentId])
  @@index([status])
}

model InstallationCalculationItem {
  id               String                     @id @default(uuid())
  calculationId    String
  workTypeId       String?
  workTypeCode     String
  workTypeName     String
  workTypeSnapshot Json
  unit             InstallationWorkUnit
  quantity         Decimal                    @db.Decimal(18, 8)
  quantitySource   InstallationQuantitySource @default(MANUAL)
  note             String?
  sortOrder        Int                        @default(0)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  calculation InstallationCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workType    InstallationWorkType?   @relation(fields: [workTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([calculationId, sortOrder])
  @@index([workTypeId])
}

model InstallationCalculationRevision {
  id            String   @id @default(uuid())
  calculationId String
  actorId       String
  action        String
  payload       Json?
  createdAt     DateTime @default(now())

  calculation InstallationCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor       User                    @relation("InstallationCalculationRevisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([calculationId, createdAt])
  @@index([actorId])
}

model InstallationCommercialCalculation {
  id                             String                        @id @default(uuid())
  leadId                         String
  installationCalculationId      String
  installationCalculationRevision Int
  revision                       Int                           @default(1)
  isCurrent                      Boolean                       @default(true)
  status                         InstallationCommercialStatus  @default(DRAFT)
  technicalSnapshot              Json
  costIncomplete                 Boolean                       @default(true)
  costByCurrency                 Json
  fxSnapshots                    Json
  proposedCustomerAmount         Decimal?                      @db.Decimal(18, 8)
  proposedCurrency               String?
  approvedCustomerAmount         Decimal?                      @db.Decimal(18, 8)
  approvedCurrency               String?
  approvedById                   String?
  approvedAt                     DateTime?
  approverRoleSnapshot           String?
  commercialNote                 String?
  quoteCreated                   Boolean                       @default(false)
  dealCreated                    Boolean                       @default(false)
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt

  lead                     Lead                                 @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  installationCalculation  InstallationCalculation              @relation(fields: [installationCalculationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy               User?                                @relation("InstallationCommercialApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items                    InstallationCommercialCalculationItem[]
  revisions                InstallationCommercialCalculationRevision[]

  @@unique([leadId, revision])
  @@index([leadId, isCurrent])
  @@index([installationCalculationId])
  @@index([status])
}

model InstallationCommercialCalculationItem {
  id                      String    @id @default(uuid())
  commercialCalculationId String
  technicalItemId         String?
  workTypeId              String?
  workTypeCode            String
  workTypeName            String
  workTypeSnapshot        Json
  unit                    String
  quantity                Decimal   @db.Decimal(18, 8)
  quantitySource          String
  selectedRateId          String?
  rateSnapshot            Json?
  contractorId            String?
  contractorName          String?
  pricePerUnit            Decimal?  @db.Decimal(18, 8)
  currency                String?
  lineCostTotal           Decimal?  @db.Decimal(18, 8)
  priceStatus             String
  fxFromCurrency          String?
  fxToCurrency            String?
  fxRate                  Decimal?  @db.Decimal(18, 8)
  fxRateId                String?
  fxEffectiveFrom         DateTime?
  convertedAmount         Decimal?  @db.Decimal(18, 8)
  convertedCurrency       String?
  sortOrder               Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  commercialCalculation InstallationCommercialCalculation @relation(fields: [commercialCalculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([commercialCalculationId, sortOrder])
}

model InstallationCommercialCalculationRevision {
  id                      String   @id @default(uuid())
  commercialCalculationId String
  actorId                 String
  action                  String
  payload                 Json?
  createdAt               DateTime @default(now())

  commercialCalculation InstallationCommercialCalculation @relation(fields: [commercialCalculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor                 User                              @relation("InstallationCommercialRevisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commercialCalculationId, createdAt])
  @@index([actorId])
}

enum ExecutionHandoffStatus {
  ACTIVE
  SUPERSEDED
}

enum ExecutionComponentStatus {
  PENDING
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

model DealExecutionHandoff {
  id             String                 @id @default(uuid())
  dealId         String
  leadId         String
  quoteId        String                 @unique
  quoteVersion   Int
  acceptedAt     DateTime
  acceptedById   String
  acceptanceNote String?
  status         ExecutionHandoffStatus @default(ACTIVE)
  revision       Int
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  deal       Deal                     @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lead       Lead                     @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  quote      PanelQuote               @relation(fields: [quoteId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  acceptedBy User                     @relation("ExecutionHandoffAcceptedBy", fields: [acceptedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  components DealExecutionComponent[]

  @@unique([dealId, revision])
  // Partial unique index DealExecutionHandoff_one_active_per_deal_idx
  // enforces a single ACTIVE row per Deal. See migration SQL.
  @@index([dealId, status])
  @@index([leadId, status])
  @@index([acceptedById])
  @@index([status, createdAt])
}

model DealExecutionComponent {
  id                String                   @id @default(uuid())
  handoffId         String
  kind              QuoteComponentKind
  required          Boolean                  @default(true)
  status            ExecutionComponentStatus @default(PENDING)
  sourceRevision    Int?
  technicalRevision Int?
  customerAmount    Decimal?                 @db.Decimal(18, 8)
  currency          String?
  label             String
  basis             Json
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  handoff DealExecutionHandoff @relation(fields: [handoffId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([handoffId, kind])
  @@index([handoffId])
  @@index([kind])
}
