  fxRates SalesPlanFxRate[]

  @@unique([userId, period])
  @@index([period])
}

/// Director-owned conversion snapshot for one SalesPlan. `rateToPlanCurrency`
/// means: 1 unit of `fromCurrency` equals this many units of the plan currency.
model SalesPlanFxRate {
  id                 String   @id @default(uuid())
  salesPlanId        String
  fromCurrency       String
  rateToPlanCurrency Decimal  @db.Decimal(18, 8)
  createdById        String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  salesPlan SalesPlan @relation(fields: [salesPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy User      @relation("SalesPlanFxRateCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([salesPlanId, fromCurrency])
  @@index([createdById])
}

model LeadPlan {
  id          String   @id @default(uuid())
  userId      String
  period      DateTime
  targetCount Int
  actualCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, period])
  @@index([period])
}

model KpiSetting {
  id                   String   @id @default(uuid())
  period               DateTime
  salesPlanWeight      Int      @default(40)
  qualifiedLeadsWeight Int      @default(15)
  conversionWeight     Int      @default(15)
  taskOnTimeWeight     Int      @default(15)
  crmDisciplineWeight  Int      @default(15)
  maxMetricValue       Int      @default(100)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([period])
}

// === P0 Infrastructure ===

model ServiceAccount {
  id          String    @id @default(uuid())
  name        String    @unique
  tokenHash   String    @unique
  permissions Json
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tokenHash])
  @@index([isActive])
}

model InboundWebhookEvent {
  id            String    @id @default(uuid())
  source        String
  externalId    String
  payloadHash   String
  payload       Json?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@unique([source, externalId])
  @@index([processedAt])
  @@index([processedAt, createdAt])
}

model TelegramLeadMetadata {
  id                  String    @id @default(uuid())
  leadId              String    @unique
  telegramUserId      String
  telegramUsername    String?
  rawPayload          Json
  isPendingAssignment Boolean   @default(true)
  assignedAt          DateTime?
  escalatedAt         DateTime?
  adminMessageId      String?
  adminChatId         String?
  createdAt           DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([telegramUserId])
  @@index([isPendingAssignment])
}

// === Panel Domain ===

model PanelType {
  id            String   @id @default(uuid())
  code          String   @unique
  displayNameRu String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  qualityMappings      SupplierQualityMapping[]
  calculationLineItems CalculationLineItem[]
  qualifications       LeadQualification[]
  qualificationItems   LeadQualificationItem[]
}

model PanelSize {
  id          String  @id @default(uuid())
  widthMm     Int
  heightMm    Int
  areaM2      Decimal @db.Decimal(10, 4)
  displayName String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  calculationLineItems CalculationLineItem[]
  qualifications       LeadQualification[]
  qualificationItems   LeadQualificationItem[]

  @@unique([widthMm, heightMm])
}

model PanelThicknessPricing {
  id             String    @id @default(uuid())
  supplierId     String
  qualityClassId String
  thicknessMm    Decimal   @db.Decimal(6, 2)
  basePricePerM2 Decimal   @db.Decimal(12, 2)
  currencyCode   String    @default("CNY")
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  isActive       Boolean   @default(true)

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass QualityClass @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, qualityClassId, thicknessMm, isActive, validFrom])
  @@index([supplierId, qualityClassId])
}

model QualityClass {
  id     String @id @default(uuid())
  code   String @unique
  nameRu String

  supplierMappings         SupplierQualityMapping[]
  calculationLineItems     CalculationLineItem[]
  thicknessPricings        PanelThicknessPricing[]
  commercialQualifications LeadCommercialQualification[]
}

model SupplierQualityMapping {
  id             String  @id @default(uuid())
  supplierId     String
  panelTypeId    String
  qualityClassId String
  isDefault      Boolean @default(false)

  supplier                 Supplier                      @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  panelType                PanelType                     @relation(fields: [panelTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass             QualityClass                  @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  commercialQualifications LeadCommercialQualification[]

  @@unique([supplierId, panelTypeId, qualityClassId])
  @@index([supplierId])
  @@index([panelTypeId])
  @@index([qualityClassId])
}

model PanelColor {
  id                 String   @id @default(uuid())
  supplierId         String
  colorCode          String
  colorName          String
  createdByManagerId String
  createdAt          DateTime @default(now())

  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  calculationLineItems CalculationLineItem[]

  @@unique([supplierId, colorCode])
  @@index([supplierId])
}

model SupplierOrder {
  id                 String              @id @default(uuid())
  dealId             String
  supplierId         String
  status             SupplierOrderStatus @default(DRAFT)
  orderedAt          DateTime?
  expectedReadyAt    DateTime?
  expectedShipmentAt DateTime?
  expectedArrivalAt  DateTime?
  comment            String?
  createdById        String?
  readyConfirmedAt   DateTime?
  readyConfirmedById String?
  estimatedDate      DateTime?
  deliveryAddress    String?
  deliveryCost       Decimal?            @db.Decimal(10, 2)
  trackingNumber     String?
  deliveredAt        DateTime?
  deliveredById      String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  deal             Deal                         @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier         Supplier                     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy        User?                        @relation("SupplierOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  readyConfirmedBy User?                        @relation("SupplierOrderReadyConfirmedBy", fields: [readyConfirmedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveredBy      User?                        @relation("SupplierOrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reminderClaims   SupplierOrderReminderClaim[]

  @@index([dealId])
  @@index([supplierId])
  @@index([status])
  @@index([expectedReadyAt])
  @@index([createdById])
  @@index([readyConfirmedById])
  @@index([deliveredById])
}

model SupplierOrderReminderClaim {
  id              String   @id @default(uuid())
  supplierOrderId String
  kind            String
  reminderDate    DateTime @db.Date
  createdAt       DateTime @default(now())

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([supplierOrderId, kind, reminderDate])
  @@index([reminderDate])
}

// === Calculation Domain (P1) ===

model CalculationRequest {
  id            String    @id @default(uuid())
  leadId        String
  clientId      String?
  dealId        String?
  createdById   String
  status        String    @default("draft")
  notes         String?
  submittedAt   DateTime?
  submittedById String?
  quotedAt      DateTime?
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead         Lead                 @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client       Client?              @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deal         Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy    User                 @relation("CalculationRequestCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy  User?                @relation("CalculationRequestSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  calculations CalculationSession[]
  quotes       PanelQuote[]

  @@index([leadId, status])
  @@index([clientId])
  @@index([dealId])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([submittedById])
  @@index([deletedAt])
}

model CalculationSession {
  id                       String    @id @default(uuid())
  requestId                String?
  leadId                   String
  dealId                   String?
  clientId                 String?
  projectObjectId          String?
  createdById              String
  status                   String    @default("draft")
  sortOrder                Int       @default(0)
  title                    String?
  totalAmount              Decimal?  @db.Decimal(12, 2)
  displayCurrency          String    @default("USD")
  cnyUsdRate               Decimal?  @db.Decimal(18, 8)
  sellingCoefficient       Decimal?  @db.Decimal(8, 4)
  notes                    String?
  commercialSupplierId     String?
  commercialQualityClassId String?
  commercialConfirmedAt    DateTime?
  deletedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  request    CalculationRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  lead       Lead                  @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy  User                  @relation("CalculationCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items      CalculationLineItem[]
  panelQuote PanelQuote?

  @@index([requestId, sortOrder])
  @@index([leadId, status])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model CalculationLineItem {
  id                    String   @id @default(uuid())
  calculationId         String
  sortOrder             Int      @default(0)
  panelTypeId           String?
  panelSizeId           String?
  thicknessMm           Decimal? @db.Decimal(6, 2)
  supplierId            String?
  qualityClassId        String?
  colorId               String?
  colorCode             String?
  colorName             String?
  coating               String?
  texture               String?
  decor                 String?
  note                  String?
  customTypeDescription String?
  customWidthMm         Int?
  customHeightMm        Int?
  requiredAreaM2        Decimal? @db.Decimal(10, 4)
  sheetsCount           Int      @default(0)
  supplierPricePerM2    Decimal  @db.Decimal(12, 2)
  clientPricePerM2      Decimal  @db.Decimal(12, 2)
  pricePerM2            Decimal  @db.Decimal(12, 2)
  pricePerSheet         Decimal  @db.Decimal(12, 2)
  totalPrice            Decimal  @db.Decimal(12, 2)
  wastePercent          Decimal  @db.Decimal(5, 2)
  createdAt             DateTime @default(now())

  calculation  CalculationSession @relation(fields: [calculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panelType    PanelType?         @relation(fields: [panelTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  panelSize    PanelSize?         @relation(fields: [panelSizeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier     Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  qualityClass QualityClass?      @relation(fields: [qualityClassId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  color        PanelColor?        @relation(fields: [colorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([calculationId, sortOrder])
}

// === Panel Quote Domain (P2) ===

model PanelQuote {
  id                     String    @id @default(uuid())
  calculationId          String?   @unique
  requestId              String?
  leadId                 String
  clientId               String?
  managerId              String
  approverId             String?
  dealId                 String?
  status                 String    @default("draft")
  totalAmount            Decimal   @db.Decimal(12, 2)
  displayCurrency        String    @default("USD")
  cnyUsdRate             Decimal?  @db.Decimal(18, 8)
  sellingCoefficient     Decimal?  @db.Decimal(8, 4)
  deliveryCost           Decimal?  @db.Decimal(10, 2)
  clientComment          String?
  commercialNote         String?
  internalCommercialNote String?
  productionTerms        String?
  deliveryTerms          String?
  productionDaysFrom     Int?
  productionDaysTo       Int?
  deliveryDaysFrom       Int?
  deliveryDaysTo         Int?
  documentDate           DateTime?
  rejectionReason        String?
  validUntil             DateTime
  clientAcceptedAt       DateTime?
  clientAcceptedById     String?
  pdfFileId              String?
  finalizedAt            DateTime?
  previousVersionId      String?   @unique
  versionNumber          Int       @default(1)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  calculation      CalculationSession? @relation(fields: [calculationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  request          CalculationRequest? @relation(fields: [requestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lead             Lead                @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client           Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager          User                @relation("QuoteManager", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approver         User?               @relation("QuoteApprover", fields: [approverId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  clientAcceptedBy User?               @relation("QuoteClientAcceptedBy", fields: [clientAcceptedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deal             Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  pdfFile          File?               @relation("QuotePdfFile", fields: [pdfFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items               PanelQuoteItem[]
  componentSnapshots  PanelQuoteComponentSnapshot[]
  previousVersion     PanelQuote?         @relation("QuoteVersions", fields: [previousVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nextVersion         PanelQuote?         @relation("QuoteVersions")
  executionHandoff    DealExecutionHandoff?

  @@unique([requestId, versionNumber])
  @@index([leadId, status])
  @@index([clientId, createdAt])
  @@index([requestId, status])
  @@index([managerId])
  @@index([approverId])
  @@index([status, createdAt])
  @@index([clientAcceptedById])
  @@index([pdfFileId])
  @@index([previousVersionId])
}

model PanelQuoteItem {
  id                        String    @id @default(uuid())
  quoteId                   String
  calculationId             String?
  calculationGroupTitle     String?
  calculationGroupSortOrder Int       @default(0)
  panelTypeCode             String
  panelTypeName             String
  panelSizeName             String
  areaM2                    Decimal   @db.Decimal(10, 4)
  thicknessMm               Decimal   @db.Decimal(6, 2)
  supplierCode              String
  supplierName              String
  qualityClassCode          String
  qualityClassName          String
  colorCode                 String?
  colorName                 String?
  coating                   String?
  texture                   String?
  note                      String?
  customTypeDescription     String?
  customWidthMm             Int?
  customHeightMm            Int?
  requiredAreaM2            Decimal   @db.Decimal(10, 4)
  sheetsCount               Int
  supplierPricePerM2        Decimal?  @db.Decimal(12, 2)
  pricePerM2                Decimal?  @db.Decimal(12, 2)
  currencyCode              String?   @default("USD")
  priceApprovedAt           DateTime?
  priceApprovedById         String?
  pricePerSheet             Decimal?  @db.Decimal(12, 2)
  totalPrice                Decimal?  @db.Decimal(12, 2)
  wastePercent              Decimal   @db.Decimal(5, 2)
  sortOrder                 Int       @default(0)
  createdAt                 DateTime  @default(now())

  quote PanelQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([quoteId, sortOrder])
  @@index([calculationId])
}

model PanelQuoteComponentSnapshot {
  id                String             @id @default(uuid())
  quoteId           String
  kind              QuoteComponentKind
  sourceId          String?
  sourceRevision    Int?
  technicalRevision Int?
  customerAmount    Decimal?           @db.Decimal(18, 8)
  currency          String?
  label             String
  description       String?
  customerSnapshot  Json
  sortOrder         Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  quote PanelQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([quoteId, kind])
  @@index([quoteId, sortOrder])
  @@index([kind, sourceId])
}

// Centralized CNY → USD rate for the HPL selling formula. Not a multi-currency FX subsystem.
model CurrencyRate {
  id            String    @id @default(uuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal   @db.Decimal(18, 8)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy User @relation("CurrencyRateCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([fromCurrency, toCurrency, effectiveFrom])
  @@index([createdById])
}

model FacadeMaterialSupplierOffer {
  id            String    @id @default(uuid())
  materialId    String
  supplierId    String
  purchasePrice Decimal   @db.Decimal(18, 8)
  currency      String
  unit          String
  validFrom     DateTime
  validTo       DateTime?
  isActive      Boolean   @default(true)
  availability  String?
  leadTimeDays  Int?
  supplierSku   String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  material FacadeMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([materialId, isActive])
  @@index([supplierId])
}

model FacadeCommercialCalculation {
  id                          String                   @id @default(uuid())
  leadId                      String
  facadeCalculationId         String
  facadeCalculationRevision   Int
  revision                    Int                      @default(1)
  isCurrent                   Boolean                  @default(true)
  status                      FacadeCommercialStatus   @default(DRAFT)
  technicalSnapshot           Json
  procurementIncomplete       Boolean                  @default(true)
  procurementByCurrency       Json
  fxSnapshots                 Json
  proposedCustomerAmount      Decimal?                 @db.Decimal(18, 8)
  proposedCurrency            String?
  approvedCustomerAmount      Decimal?                 @db.Decimal(18, 8)
  approvedCurrency            String?
  approvedById                String?
  approvedAt                  DateTime?
  approverRoleSnapshot        String?
  commercialNote              String?
  quoteCreated                Boolean                  @default(false)
  dealCreated                 Boolean                  @default(false)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt

  lead              Lead                               @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  facadeCalculation FacadeSubsystemCalculation         @relation(fields: [facadeCalculationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy        User?                              @relation("FacadeCommercialApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items             FacadeCommercialCalculationItem[]
  revisions         FacadeCommercialCalculationRevision[]

  @@unique([leadId, revision])
  @@index([leadId, isCurrent])
  @@index([facadeCalculationId])
  @@index([status])
}

model FacadeCommercialCalculationItem {
  id                                   String    @id @default(uuid())
  commercialCalculationId              String
  technicalItemId                      String?
  materialId                           String?
  materialCode                         String
  materialName                         String
  materialSnapshot                     Json
  category                             String
  unit                                 String
  finalQty                             Decimal   @db.Decimal(18, 8)
  excludedFromSubsystemCommercialCost  Boolean   @default(false)
  selectedOfferId                      String?
  offerSnapshot                        Json?
  purchasePrice                        Decimal?  @db.Decimal(18, 8)
  purchaseCurrency                     String?
  linePurchaseTotal                    Decimal?  @db.Decimal(18, 8)
  priceStatus                          String
  fxFromCurrency                       String?
  fxToCurrency                         String?
  fxRate                               Decimal?  @db.Decimal(18, 8)
  fxRateId                             String?
  fxEffectiveFrom                      DateTime?
  convertedAmount                      Decimal?  @db.Decimal(18, 8)
  convertedCurrency                    String?
  sortOrder                            Int       @default(0)
  createdAt                            DateTime  @default(now())
  updatedAt                            DateTime  @updatedAt

  commercialCalculation FacadeCommercialCalculation @relation(fields: [commercialCalculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([commercialCalculationId, sortOrder])
}

model FacadeCommercialCalculationRevision {
  id                      String   @id @default(uuid())
  commercialCalculationId String
  actorId                 String
  action                  String
  payload                 Json?
  createdAt               DateTime @default(now())

  commercialCalculation FacadeCommercialCalculation @relation(fields: [commercialCalculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor                 User                        @relation("FacadeCommercialRevisionActor", fields: [actorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([commercialCalculationId, createdAt])
}

model InstallationWorkType {
