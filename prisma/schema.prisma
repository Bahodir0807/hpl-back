generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  DIRECTOR
  HEAD
  MANAGER
  ACCOUNTANT
  STOREKEEPER
  ENGINEER
}

enum EngineeringAssignmentStatus {
  ACTIVE
  RETURNED
  COMPLETED
  SUPERSEDED
}

enum FacadeMaterialCategory {
  HPL
  SUBSYSTEM
  INSULATION
  MEMBRANE
  FASTENER
  SEALING_TAPE
  ADDITIONAL
}

enum FacadeMaterialUnit {
  M2
  PCS
  LM
}

enum FacadeCalculationStatus {
  DRAFT
  CALCULATED
  UNSUPPORTED
}

enum FacadeAreaSource {
  ENGINEER_ENTERED
  HPL_QUALIFICATION
}

enum FacadeCommercialStatus {
  DRAFT
  READY_FOR_APPROVAL
  APPROVED
}

enum InstallationWorkUnit {
  M2
  LM
  PCS
  SET
  HOUR
  DAY
  OTHER
}

enum InstallationWorkCategory {
  CLADDING
  BRACKETS
  SLOPES
  TRAVEL
  HEIGHT
  OTHER
}

enum InstallationContractorType {
  INTERNAL_CREW
  EXTERNAL_CONTRACTOR
}

enum InstallationQuantitySource {
  MANUAL
  CONFIRMED_AREA
  APPROVED_NORM
}

enum InstallationCalculationStatus {
  DRAFT
  READY
}

enum InstallationCommercialStatus {
  DRAFT
  READY_FOR_APPROVAL
  APPROVED
}

enum QuoteComponentKind {
  HPL
  FACADE
  INSTALLATION
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductPriceType {
  BASE
  PURCHASE
  WHOLESALE
  RETAIL
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
  BLACKLISTED
}

enum ClientSegment {
  DEALER
  ARCHITECT
  CONTRACTOR
  END_CUSTOMER
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  CONVERTED
  LOST
}

enum LossReason {
  PRICE
  NO_STOCK
  LEAD_TIME
  COMPETITOR
  QUALITY
  SIZE
  CLIENT_CANCELLED
  OTHER
}

enum FulfillmentSource {
  WAREHOUSE_STOCK
  SUPPLIER_ORDER
}

enum CommercialQualificationStatus {
  CONFIRMED
}

enum TaskType {
  FIRST_CONTACT
  CALL
  MESSAGE
  EMAIL
  MEETING
  SAMPLE_SEND
  CALCULATION
  OFFER
  PAYMENT_CHECK
  SHIPMENT_CHECK
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskComputedStatus {
  ON_TIME
  WARNING
  TODAY
  OVERDUE
  CRITICAL_OVERDUE
  BLOCKED
}

enum DealStage {
  QUALIFICATION
  HPL_SELECTION
  OFFER_PREPARATION
  NEGOTIATION
  AGREEMENT_PENDING
  PAYMENT_PREPARATION
  SHIPPED
  WON
  LOST
}

// ТЗ 5.10 (ORD-03): 9 статусов — DRAFT, CONFIRMED, WAITING_PAYMENT,
// PARTIALLY_PAID, PAID, WAITING_STOCK, READY_FOR_SHIPMENT, SHIPPED, CANCELLED.
// PARTIALLY_SHIPPED и COMPLETED — сверх ТЗ, но активно используются
// в delivery-FSM (orders.service) и guard'ах терминальных статусов.
enum OrderStatus {
  DRAFT
  CONFIRMED
  WAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  WAITING_STOCK
  PENDING_SUPPLIER
  READY_FOR_SHIPMENT
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum SupplierOrderStatus {
  DRAFT
  SENT_TO_PRODUCTION
  IN_PRODUCTION
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentRecordStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DeliveryStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum StockAdjustmentType {
  IN
  OUT
  CORRECTION
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum OrderItemSource {
  SKU
  PANEL_CALCULATOR
}

enum ExpectedReceiptStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  FILE_UPLOADED
  TASK_COMPLETED
  PAYMENT_RECEIVED
  DELIVERY_CREATED
  RESERVATION_CREATED
  STAGE_CHANGED
  OWNER_CHANGED
  STATUS_CHANGED
  CALCULATION
  SUPPLIER_ORDER_STATUS_CHANGED
  CLIENT_DELIVERY_CONFIRMED
  INSTALLATION_UPDATED
  DEAL_COMPLETED
}

enum InstallationStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

enum HplApplication {
  INTERIOR
  EXTERIOR_WITH_UV
  LABORATORY
  FURNITURE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  teamId       String?
  managerId    String?
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team                              Team?                         @relation("TeamUsers", fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager                           User?                         @relation("UserManagement", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates                      User[]                        @relation("UserManagement")
  ledTeams                          Team[]                        @relation("TeamLeader")
  roles                             UserRole[]
  permissions                       UserPermission[]
  sessions                          Session[]
  activityLogs                      UserActivityLog[]
  ownedClients                      Client[]                      @relation("ClientOwner")
  ownedLeads                        Lead[]                        @relation("LeadOwner")
  ownedDeals                        Deal[]                        @relation("DealOwner")
  assignedTasks                     Task[]                        @relation("TaskAssignee")
  createdTasks                      Task[]                        @relation("TaskCreator")
  createdActivities                 Activity[]                    @relation("ActivityAuthor")
  auditLogs                         AuditLog[]                    @relation("AuditLogUser")
  uploadedFiles                     File[]                        @relation("FileUploader")
  leadAssignmentsFrom               LeadAssignmentHistory[]       @relation("LeadPreviousOwner")
  leadAssignmentsTo                 LeadAssignmentHistory[]       @relation("LeadNewOwner")
  leadAssignmentsMade               LeadAssignmentHistory[]       @relation("LeadAssignedBy")
  taskReschedules                   TaskRescheduleHistory[]       @relation("TaskRescheduleAuthor")
  notifications                     Notification[]
  stockAdjustments                  StockAdjustment[]
  payments                          Payment[]
  salesPlans                        SalesPlan[]
  createdSalesPlanFxRates           SalesPlanFxRate[]             @relation("SalesPlanFxRateCreator")
  leadPlans                         LeadPlan[]
  dealStageHistories                DealStageHistory[]
  stageExceptionApprovals           DealStageHistory[]            @relation("StageExceptionApprover")
  createdCalculations               CalculationSession[]          @relation("CalculationCreator")
  createdCalculationRequests        CalculationRequest[]          @relation("CalculationRequestCreator")
  submittedCalculationRequests      CalculationRequest[]          @relation("CalculationRequestSubmittedBy")
  panelQuotes                       PanelQuote[]                  @relation("QuoteManager")
  approvedQuotes                    PanelQuote[]                  @relation("QuoteApprover")
  clientAcceptedQuotes              PanelQuote[]                  @relation("QuoteClientAcceptedBy")
  createdSupplierOrders             SupplierOrder[]               @relation("SupplierOrderCreatedBy")
  readyConfirmedSupplierOrders      SupplierOrder[]               @relation("SupplierOrderReadyConfirmedBy")
  deliveredSupplierOrders           SupplierOrder[]               @relation("SupplierOrderDeliveredBy")
  createdExpectedReceipts           ExpectedReceipt[]             @relation("ExpectedReceiptCreatedBy")
  receivedExpectedReceipts          ExpectedReceiptEvent[]        @relation("ExpectedReceiptReceivedBy")
  createdCurrencyRates              CurrencyRate[]                @relation("CurrencyRateCreator")
  confirmedCommercialQualifications LeadCommercialQualification[] @relation("LeadCommercialConfirmedBy")
  assessedInstallations             DealInstallation[]            @relation("InstallationAssessedBy")
  startedInstallations              DealInstallation[]            @relation("InstallationStartedBy")
  installerConfirmedInstallations   DealInstallation[]            @relation("InstallationInstallerConfirmedBy")
  supervisorConfirmedInstallations  DealInstallation[]            @relation("InstallationSupervisorConfirmedBy")
  lostLeads                         Lead[]                        @relation("LeadLostBy")
  lostDeals                         Deal[]                        @relation("DealLostBy")
  managerCommercialHandoffs         Lead[]                        @relation("LeadManagerCommercialInputReadyBy")
  engineeringAssignments            LeadEngineeringAssignment[]   @relation("LeadEngineeringEngineer")
  engineeringAssignmentsMade        LeadEngineeringAssignment[]   @relation("LeadEngineeringAssignedBy")
  engineeringReturns                LeadEngineeringAssignment[]   @relation("LeadEngineeringReturnedBy")
  engineeringCompletions            LeadEngineeringAssignment[]   @relation("LeadEngineeringCompletedBy")
  engineeringPrimaryCompletions     LeadEngineeringAssignment[]   @relation("LeadEngineeringPrimaryCompletedBy")
  facadeSubsystemCalculations       FacadeSubsystemCalculation[]  @relation("FacadeCalculationEngineer")
  facadeSubsystemRevisions          FacadeSubsystemCalculationRevision[] @relation("FacadeCalculationRevisionActor")
  facadeCommercialApprovals         FacadeCommercialCalculation[] @relation("FacadeCommercialApprover")
  facadeCommercialRevisions         FacadeCommercialCalculationRevision[] @relation("FacadeCommercialRevisionActor")
  installationCalculations          InstallationCalculation[]     @relation("InstallationCalculationEngineer")
  installationCalculationRevisions  InstallationCalculationRevision[] @relation("InstallationCalculationRevisionActor")
  installationCommercialApprovals   InstallationCommercialCalculation[] @relation("InstallationCommercialApprover")
  installationCommercialRevisions   InstallationCommercialCalculationRevision[] @relation("InstallationCommercialRevisionActor")
  executionHandoffsAccepted         DealExecutionHandoff[]            @relation("ExecutionHandoffAcceptedBy")

  @@index([teamId])
  @@index([managerId])
  @@index([isActive])
  @@index([phone])
}

model Team {
  id        String   @id @default(uuid())
  name      String   @unique
  leaderId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leader User?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  users  User[] @relation("TeamUsers")

  @@index([leaderId])
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid())
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserActivityLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Supplier {
  id               String   @id @default(uuid())
  name             String
  code             String   @unique
  contacts         Json?
  deliveryDays     Int?
  moqM2            Decimal? @db.Decimal(10, 2)
  deliveryTerms    String? // pickup | carrier | supplier_delivery
  isDirectDelivery Boolean  @default(true)
  marginPercent    Decimal? @db.Decimal(5, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  products                 Product[]
  expectedReceipts         ExpectedReceipt[]
  qualityMappings          SupplierQualityMapping[]
  calculationLineItems     CalculationLineItem[]
  panelColors              PanelColor[]
  thicknessPricings        PanelThicknessPricing[]
  supplierOrders           SupplierOrder[]
  deals                    Deal[]
  commercialQualifications LeadCommercialQualification[]
  facadeMaterialOffers     FacadeMaterialSupplierOffer[]
  installationContractors  InstallationContractor[]

  @@index([name])
}

model Brand {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  collections ProductCollection[]

  @@index([name])
}

model ProductCollection {
  id        String   @id @default(uuid())
  name      String
  brandId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products Product[]

  @@unique([brandId, name])
  @@index([brandId])
}

model Product {
  id           String        @id @default(uuid())
  sku          String        @unique
  name         String
  brandId      String
  collectionId String?
  supplierId   String?
  decorCode    String?
  colorName    String?
  surface      String?
  thickness    Float
  length       Float
  width        Float
  unit         String        @default("m2")
  sheetArea    Float
  status       ProductStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  brand                     Brand                      @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  collection                ProductCollection?         @relation(fields: [collectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier                  Supplier?                  @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  prices                    ProductPrice[]
  stockBalance              StockBalance?
  stockAdjustments          StockAdjustment[]
  stockReservations         StockReservation[]
  expectedReceiptItems      ExpectedReceiptItem[]
  expectedReceiptEventItems ExpectedReceiptEventItem[]
  dealItems                 DealItem[]
  orderItems                OrderItem[]
  projectObjects            ProjectObject[]

  @@index([brandId])
  @@index([collectionId])
  @@index([collectionId, thickness, status])
  @@index([supplierId])
  @@index([status])
  @@index([decorCode])
  @@index([colorName])
  @@index([surface])
  @@index([thickness])
  @@index([deletedAt])
}

model ProductPrice {
  id        String           @id @default(uuid())
  productId String
  type      ProductPriceType
  amount    Decimal
  currency  String           @default("RUB")
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([type])
  @@index([productId, type, validFrom])
  @@index([validFrom])
  @@index([validTo])
}

model File {
  id           String   @id @default(uuid())
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  uploadedById String
  relatedType  String
  relatedId    String
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy  User         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dealOffers  DealOffer[]  @relation("DealOfferFile")
  payments    Payment[]    @relation("PaymentFile")
  deliveries  Delivery[]   @relation("DeliveryFile")
  panelQuotes PanelQuote[] @relation("QuotePdfFile")

  @@index([uploadedById])
  @@index([relatedType, relatedId])
  @@index([mimeType])
  @@index([createdAt])
}

model Client {
  id        String         @id @default(uuid())
  type      ClientType
  name      String
  inn       String?
  phone     String?
  email     String?
  status    ClientStatus   @default(ACTIVE)
  segment   ClientSegment?
  region    String?
  address   String?
  source    String?
  comment   String?
  ownerId   String
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner               User                 @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contacts            Contact[]
  projectObjects      ProjectObject[]
  leads               Lead[]
  deals               Deal[]
  calculationRequests CalculationRequest[]
  panelQuotes         PanelQuote[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([status])
  @@index([inn])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@index([region])
  @@index([deletedAt])
  @@index([createdAt])
}

model Contact {
  id               String   @id @default(uuid())
  clientId         String
  firstName        String
  lastName         String?
  position         String?
  role             String?
  phone            String?
  messenger        String?
  email            String?
  preferredChannel String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leads          Lead[]
  projectObjects ProjectObject[] @relation("DecisionMakerContact")

  @@index([clientId])
  @@index([phone])
  @@index([email])
}

model ProjectObject {
  id                     String    @id @default(uuid())
  clientId               String
  name                   String
  address                String?
  type                   String?
  stage                  String?
  approximateArea        Float?
  expectedDate           DateTime?
  description            String?
  decisionMakerContactId String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decisionMakerContact Contact?  @relation("DecisionMakerContact", fields: [decisionMakerContactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leads                Lead[]
  deals                Deal[]
  products             Product[]

  @@index([clientId])
  @@index([decisionMakerContactId])
  @@index([expectedDate])
  @@index([stage])
}

model Lead {
  id                    String      @id @default(uuid())
  title                 String
  status                LeadStatus  @default(NEW)
  source                String
  ownerId               String
  clientId              String?
  contactId             String?
  dealId                String?     @unique
  needDescription       String?
  estimatedAmount       Decimal?
  targetDate            DateTime?
  projectObjectId       String?
  decisionMakerContact  String?
  unqualificationReason String?
  lostReasonCode        LossReason?
  lostComment           String?
  lostAt                DateTime?
  lostById              String?
  deletedAt             DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  managerCommercialNote           String?
  managerCommercialNoteUpdatedAt  DateTime?
  managerCommercialInputReadyAt   DateTime?
  managerCommercialInputReadyById String?

  owner                         User                         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client                        Client?                      @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contact                       Contact?                     @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deal                          Deal?                        @relation("LeadConvertedDeal", fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  projectObject                 ProjectObject?               @relation(fields: [projectObjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignmentHistory             LeadAssignmentHistory[]
  engineeringAssignments        LeadEngineeringAssignment[]
  facadeSubsystemCalculations   FacadeSubsystemCalculation[]
  facadeCommercialCalculations  FacadeCommercialCalculation[]
  installationCalculation       InstallationCalculation?
  installationCommercialCalculations InstallationCommercialCalculation[]
  calculationRequests           CalculationRequest[]
  calculationSessions           CalculationSession[]
  panelQuotes                   PanelQuote[]
  executionHandoffs             DealExecutionHandoff[]
  telegramLeadMetadata          TelegramLeadMetadata?
  qualification                 LeadQualification?
  commercialQualification       LeadCommercialQualification?
  lostBy                        User?                        @relation("LeadLostBy", fields: [lostById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  managerCommercialInputReadyBy User?                        @relation("LeadManagerCommercialInputReadyBy", fields: [managerCommercialInputReadyById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([ownerId])
  @@index([ownerId, status, createdAt])
  @@index([clientId])
  @@index([contactId])
  @@index([status])
  @@index([source])
  @@index([targetDate])
  @@index([projectObjectId])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([lostReasonCode])
  @@index([lostAt])
  @@index([lostById])
  @@index([managerCommercialInputReadyAt])
  @@index([managerCommercialInputReadyById])
}

model LeadQualification {
  id     String @id @default(uuid())
  leadId String @unique

  application           HplApplication?
  panelTypeId           String?
  thicknessMm           Decimal?        @db.Decimal(6, 2)
  panelSizeId           String?
  customWidthMm         Int?
  customHeightMm        Int?
  colorCode             String?
  colorName             String?
  requiredAreaM2        Decimal?        @db.Decimal(10, 4)
  installationRequired  Boolean?
  stockOnly             Boolean?
  urgent                Boolean?
  willingToWait         Boolean?
  ventFacadeExists      Boolean?
  ventFacadeKitRequired Boolean?
  customerRequirements  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead      Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panelType PanelType?              @relation(fields: [panelTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  panelSize PanelSize?              @relation(fields: [panelSizeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items     LeadQualificationItem[]

  @@index([application])
  @@index([panelTypeId])
  @@index([panelSizeId])
  @@index([installationRequired])
  @@index([stockOnly])
  @@index([urgent])
}

model LeadQualificationItem {
  id              String          @id @default(uuid())
  qualificationId String
  sortOrder       Int             @default(0)
  application     HplApplication?
  panelTypeId     String?
  thicknessMm     Decimal?        @db.Decimal(6, 2)
  panelSizeId     String?
  customWidthMm   Int?
  customHeightMm  Int?
  colorCode       String?
  colorName       String?
  coating         String?
  texture         String?
  requiredAreaM2  Decimal?        @db.Decimal(10, 4)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  qualification LeadQualification @relation(fields: [qualificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panelType     PanelType?        @relation(fields: [panelTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  panelSize     PanelSize?        @relation(fields: [panelSizeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([qualificationId, sortOrder])
  @@index([panelTypeId])
  @@index([panelSizeId])
}

model LeadCommercialQualification {
  id              String                        @id @default(uuid())
  leadId          String                        @unique
  supplierId      String
  qualityClassId  String
  mappingId       String?
  status          CommercialQualificationStatus @default(CONFIRMED)
  decisionComment String?
  confirmedById   String
  confirmedAt     DateTime
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  lead         Lead                    @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  supplier     Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass QualityClass            @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mapping      SupplierQualityMapping? @relation(fields: [mappingId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  confirmedBy  User                    @relation("LeadCommercialConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([supplierId])
  @@index([qualityClassId])
  @@index([mappingId])
