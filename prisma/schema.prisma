generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  ADMIN
  HEAD
  MANAGER
  STOREKEEPER
  OBSERVER
}

enum ProductStatus {
  ACTIVE
  ARCHIVED
  OUT_OF_STOCK
}

enum ProductPriceType {
  BASE
  PURCHASE
  WHOLESALE
  RETAIL
}

enum ClientType {
  COMPANY
  INDIVIDUAL
}

enum ClientStatus {
  ACTIVE
  ARCHIVED
  BLACKLISTED
}

enum ClientSegment {
  DEALER
  ARCHITECT
  CONTRACTOR
  END_CUSTOMER
  OTHER
}

enum LeadStatus {
  NEW
  IN_PROGRESS
  QUALIFIED
  UNQUALIFIED
  CONVERTED
}

enum TaskType {
  FIRST_CONTACT
  CALL
  MESSAGE
  EMAIL
  MEETING
  SAMPLE_SEND
  CALCULATION
  OFFER
  PAYMENT_CHECK
  SHIPMENT_CHECK
  OTHER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskComputedStatus {
  ON_TIME
  WARNING
  TODAY
  OVERDUE
  CRITICAL_OVERDUE
  BLOCKED
}

enum DealStage {
  QUALIFICATION
  HPL_SELECTION
  OFFER_PREPARATION
  NEGOTIATION
  AGREEMENT_PENDING
  PAYMENT_PREPARATION
  SHIPPED
  WON
  LOST
}

// ТЗ 5.10 (ORD-03): 9 статусов — DRAFT, CONFIRMED, WAITING_PAYMENT,
// PARTIALLY_PAID, PAID, WAITING_STOCK, READY_FOR_SHIPMENT, SHIPPED, CANCELLED.
// PARTIALLY_SHIPPED и COMPLETED — сверх ТЗ, но активно используются
// в delivery-FSM (orders.service) и guard'ах терминальных статусов.
enum OrderStatus {
  DRAFT
  CONFIRMED
  WAITING_PAYMENT
  PARTIALLY_PAID
  PAID
  WAITING_STOCK
  PENDING_SUPPLIER
  READY_FOR_SHIPMENT
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum SupplierOrderStatus {
  DRAFT
  SENT_TO_PRODUCTION
  IN_PRODUCTION
  READY_FOR_SHIPMENT
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

enum PaymentRecordStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum DeliveryStatus {
  PLANNED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum StockAdjustmentType {
  IN
  OUT
  CORRECTION
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  FULFILLED
}

enum OrderItemSource {
  SKU
  PANEL_CALCULATOR
}

enum ExpectedReceiptStatus {
  PENDING
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum ActivityType {
  NOTE
  CALL
  EMAIL
  MEETING
  FILE_UPLOADED
  TASK_COMPLETED
  PAYMENT_RECEIVED
  DELIVERY_CREATED
  RESERVATION_CREATED
  STAGE_CHANGED
  OWNER_CHANGED
  STATUS_CHANGED
  CALCULATION
  SUPPLIER_ORDER_STATUS_CHANGED
}

enum HplApplication {
  INTERIOR
  EXTERIOR
}

model User {
  id           String    @id @default(uuid()) 
  email        String    @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  isActive     Boolean   @default(true)
  teamId       String?   
  managerId    String?   
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  team                    Team?                   @relation("TeamUsers", fields: [teamId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  manager                 User?                   @relation("UserManagement", fields: [managerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  subordinates            User[]                  @relation("UserManagement")
  ledTeams                Team[]                  @relation("TeamLeader")
  roles                   UserRole[]
  permissions             UserPermission[]
  sessions                Session[]
  activityLogs            UserActivityLog[]
  ownedClients            Client[]                @relation("ClientOwner")
  ownedLeads              Lead[]                  @relation("LeadOwner")
  ownedDeals              Deal[]                  @relation("DealOwner")
  assignedTasks           Task[]                  @relation("TaskAssignee")
  createdTasks            Task[]                  @relation("TaskCreator")
  createdActivities       Activity[]              @relation("ActivityAuthor")
  auditLogs               AuditLog[]              @relation("AuditLogUser")
  uploadedFiles           File[]                  @relation("FileUploader")
  leadAssignmentsFrom     LeadAssignmentHistory[] @relation("LeadPreviousOwner")
  leadAssignmentsTo       LeadAssignmentHistory[] @relation("LeadNewOwner")
  leadAssignmentsMade     LeadAssignmentHistory[] @relation("LeadAssignedBy")
  taskReschedules         TaskRescheduleHistory[] @relation("TaskRescheduleAuthor")
  notifications           Notification[]
  stockAdjustments        StockAdjustment[]
  payments                Payment[]
  salesPlans              SalesPlan[]
  leadPlans               LeadPlan[]
  dealStageHistories      DealStageHistory[]
  stageExceptionApprovals DealStageHistory[]      @relation("StageExceptionApprover")
  createdCalculations     CalculationSession[]    @relation("CalculationCreator")
  panelQuotes             PanelQuote[]            @relation("QuoteManager")
  createdCurrencyRates    CurrencyRate[]          @relation("CurrencyRateCreator")

  @@index([teamId])
  @@index([managerId])
  @@index([isActive])
  @@index([phone])
}

model Team {
  id        String   @id @default(uuid()) 
  name      String   @unique
  leaderId  String?  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leader User?  @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  users  User[] @relation("TeamUsers")

  @@index([leaderId])
}

model Role {
  id          String   @id @default(uuid()) 
  name        RoleName @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles   UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(uuid()) 
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model UserRole {
  userId String 
  roleId String 

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model RolePermission {
  roleId       String 
  permissionId String 

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserPermission {
  userId       String 
  permissionId String 

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, permissionId])
  @@index([permissionId])
}

model Session {
  id        String   @id @default(uuid()) 
  userId    String   
  tokenHash String
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserActivityLog {
  id        String   @id @default(uuid()) 
  userId    String   
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Supplier {
  id                String   @id @default(uuid()) 
  name              String
  code              String   @unique
  contacts          Json?
  deliveryDays      Int?
  moqM2             Decimal? @db.Decimal(10, 2)
  deliveryTerms     String?  // pickup | carrier | supplier_delivery
  isDirectDelivery  Boolean  @default(true)
  marginPercent     Decimal? @db.Decimal(5, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  products             Product[]
  expectedReceipts     ExpectedReceipt[]
  qualityMappings      SupplierQualityMapping[]
  calculationLineItems CalculationLineItem[]
  panelColors          PanelColor[]
  thicknessPricings    PanelThicknessPricing[]
  supplierOrders       SupplierOrder[]
  deals                Deal[]

  @@index([name])
}

model Brand {
  id        String   @id @default(uuid()) 
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products    Product[]
  collections ProductCollection[]

  @@index([name])
}

model ProductCollection {
  id        String   @id @default(uuid()) 
  name      String
  brandId   String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand    Brand     @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  products Product[]

  @@unique([brandId, name])
  @@index([brandId])
}

model Product {
  id           String        @id @default(uuid()) 
  sku          String        @unique
  name         String
  brandId      String        
  collectionId String?       
  supplierId   String?       
  decorCode    String?
  colorName    String?
  surface      String?
  thickness    Float
  length       Float
  width        Float
  unit         String        @default("m2")
  sheetArea    Float
  status       ProductStatus @default(ACTIVE)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  brand                Brand                 @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  collection           ProductCollection?    @relation(fields: [collectionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier             Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  prices               ProductPrice[]
  stockBalance         StockBalance?
  stockAdjustments     StockAdjustment[]
  stockReservations    StockReservation[]
  expectedReceiptItems ExpectedReceiptItem[]
  dealItems            DealItem[]
  orderItems           OrderItem[]
  projectObjects       ProjectObject[]

  @@index([brandId])
  @@index([collectionId])
  @@index([collectionId, thickness, status])
  @@index([supplierId])
  @@index([status])
  @@index([decorCode])
  @@index([colorName])
  @@index([surface])
  @@index([thickness])
  @@index([deletedAt])
}

model ProductPrice {
  id        String           @id @default(uuid()) 
  productId String           
  type      ProductPriceType
  amount    Decimal          
  currency  String           @default("RUB")
  validFrom DateTime
  validTo   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([type])
  @@index([productId, type, validFrom])
  @@index([validFrom])
  @@index([validTo])
}

model File {
  id           String   @id @default(uuid()) 
  originalName String
  mimeType     String
  size         Int
  storageKey   String   @unique
  uploadedById String   
  relatedType  String
  relatedId    String
  comment      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User        @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dealOffers DealOffer[] @relation("DealOfferFile")
  payments   Payment[]   @relation("PaymentFile")
  deliveries Delivery[]  @relation("DeliveryFile")

  @@index([uploadedById])
  @@index([relatedType, relatedId])
  @@index([mimeType])
  @@index([createdAt])
}

model Client {
  id        String         @id @default(uuid()) 
  type      ClientType
  name      String
  inn       String?
  phone     String?
  email     String?
  status    ClientStatus   @default(ACTIVE)
  segment   ClientSegment?
  region    String?
  address   String?
  source    String?
  comment   String?        
  ownerId   String         
  deletedAt DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  owner          User            @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contacts       Contact[]
  projectObjects ProjectObject[]
  leads          Lead[]
  deals          Deal[]

  @@index([ownerId])
  @@index([ownerId, createdAt])
  @@index([status])
  @@index([inn])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@index([region])
  @@index([deletedAt])
  @@index([createdAt])
}

model Contact {
  id               String   @id @default(uuid()) 
  clientId         String   
  firstName        String
  lastName         String?
  position         String?
  role             String?
  phone            String?
  messenger        String?
  email            String?
  preferredChannel String?
  isPrimary        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  client         Client          @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leads          Lead[]
  projectObjects ProjectObject[] @relation("DecisionMakerContact")

  @@index([clientId])
  @@index([phone])
  @@index([email])
}

model ProjectObject {
  id                     String    @id @default(uuid()) 
  clientId               String    
  name                   String
  address                String?
  type                   String?
  stage                  String?
  approximateArea        Float?
  expectedDate           DateTime?
  description            String?   
  decisionMakerContactId String?   
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  client               Client   @relation(fields: [clientId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  decisionMakerContact Contact? @relation("DecisionMakerContact", fields: [decisionMakerContactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  leads                Lead[]
  deals                Deal[]
  products             Product[]

  @@index([clientId])
  @@index([decisionMakerContactId])
  @@index([expectedDate])
  @@index([stage])
}

model Lead {
  id                    String     @id @default(uuid()) 
  title                 String
  status                LeadStatus @default(NEW)
  source                String
  ownerId               String     
  clientId              String?    
  contactId             String?    
  dealId                String?    @unique 
  needDescription       String?    
  estimatedAmount       Decimal?   
  targetDate            DateTime?
  projectObjectId       String?    
  decisionMakerContact  String?
  unqualificationReason String?
  deletedAt             DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  owner             User                    @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client            Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  contact           Contact?                @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deal              Deal?                   @relation("LeadConvertedDeal", fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  projectObject     ProjectObject?          @relation(fields: [projectObjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignmentHistory LeadAssignmentHistory[]
  calculationSessions CalculationSession[]
  panelQuotes           PanelQuote[]
  telegramLeadMetadata  TelegramLeadMetadata?
  qualification         LeadQualification?

  @@index([ownerId])
  @@index([ownerId, status, createdAt])
  @@index([clientId])
  @@index([contactId])
  @@index([status])
  @@index([source])
  @@index([targetDate])
  @@index([projectObjectId])
  @@index([deletedAt])
  @@index([createdAt])
}

model LeadQualification {
  id     String @id @default(uuid())
  leadId String @unique

  application            HplApplication?
  panelTypeId            String?
  thicknessMm            Int?
  panelSizeId            String?
  customWidthMm          Int?
  customHeightMm         Int?
  colorCode              String?
  colorName              String?
  requiredAreaM2         Decimal? @db.Decimal(10, 4)
  installationRequired   Boolean?
  stockOnly              Boolean?
  urgent                 Boolean?
  willingToWait          Boolean?
  customerRequirements   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panelType PanelType? @relation(fields: [panelTypeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  panelSize PanelSize? @relation(fields: [panelSizeId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([application])
  @@index([panelTypeId])
  @@index([panelSizeId])
  @@index([installationRequired])
  @@index([stockOnly])
  @@index([urgent])
}

model LeadAssignmentHistory {
  id              String   @id @default(uuid()) 
  leadId          String   
  previousOwnerId String?  
  newOwnerId      String   
  assignedById    String   
  createdAt       DateTime @default(now())

  lead          Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  previousOwner User? @relation("LeadPreviousOwner", fields: [previousOwnerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  newOwner      User  @relation("LeadNewOwner", fields: [newOwnerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedBy    User  @relation("LeadAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([leadId])
  @@index([previousOwnerId])
  @@index([newOwnerId])
  @@index([assignedById])
  @@index([createdAt])
}

model Task {
  id              String             @id @default(uuid()) 
  title           String
  description     String?            
  type            TaskType
  status          TaskStatus         @default(PENDING)
  priority        TaskPriority       @default(MEDIUM)
  computedStatus  TaskComputedStatus @default(ON_TIME)
  dueDate         DateTime
  originalDueDate DateTime
  result          String?            
  completedAt     DateTime?
  rescheduleCount Int                @default(0)
  assigneeId      String             
  createdById     String             
  relatedType     String
  relatedId       String             
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  assignee          User                    @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy         User                    @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  rescheduleHistory TaskRescheduleHistory[]
  notifications     Notification[]

  @@index([relatedType, relatedId])
  @@index([assigneeId, dueDate])
  @@index([assigneeId, computedStatus, dueDate])
  @@index([createdById])
  @@index([status])
  @@index([computedStatus])
  @@index([dueDate])
  @@index([completedAt])
}

model TaskRescheduleHistory {
  id         String   @id @default(uuid()) 
  taskId     String   
  oldDueDate DateTime
  newDueDate DateTime
  reason     String   
  authorId   String   
  createdAt  DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author User @relation("TaskRescheduleAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId])
  @@index([authorId])
  @@index([createdAt])
}

model Notification {
  id          String    @id @default(uuid()) 
  userId      String    
  taskId      String?   
  title       String
  message     String?   
  type        String
  relatedType String?
  relatedId   String?   
  isRead      Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  task Task? @relation(fields: [taskId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([taskId])
  @@index([isRead])
  @@index([createdAt])
  @@index([relatedType, relatedId])
}

model Deal {
  id                String    @id @default(uuid()) 
  title             String
  stage             DealStage @default(QUALIFICATION)
  clientId          String    
  projectObjectId   String?   
  ownerId           String    
  totalAmount       Decimal   @default(0) 
  currency          String    @default("RUB")
  discountAmount    Decimal   @default(0) 
  probability       Int       @default(0)
  expectedCloseDate DateTime?
  nextActionAt      DateTime?
  margin            Decimal   @default(0) 
  lossReason        String?
  competitorName    String?
  comment           String?   
  result            String?
  deletedAt         DateTime?
  supplierId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  client            Client             @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  projectObject     ProjectObject?     @relation(fields: [projectObjectId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  owner             User               @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier          Supplier?          @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  convertedFromLead Lead?              @relation("LeadConvertedDeal")
  items             DealItem[]
  offers            DealOffer[]
  order             Order?
  stageHistory      DealStageHistory[]
  panelQuotes       PanelQuote[]
  supplierOrder     SupplierOrder?

  @@index([clientId])
  @@index([projectObjectId])
  @@index([ownerId])
  @@index([ownerId, stage, createdAt])
  @@index([stage])
  @@index([expectedCloseDate])
  @@index([nextActionAt])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([supplierId])
}

model DealItem {
  id                    String   @id @default(uuid()) 
  dealId                String   
  productId             String   
  quantitySheets        Float
  quantityM2            Float
  unitPrice             Decimal  
  discount              Decimal  @default(0) 
  totalPrice            Decimal  
  purchasePriceSnapshot Decimal? 
  source                OrderItemSource @default(SKU)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([dealId])
  @@index([productId])
}

model DealOffer {
  id         String    @id @default(uuid()) 
  dealId     String    
  version    Int       @default(1)
  number     String?
  amount     Decimal?  
  pdfFileId  String?   
  validUntil DateTime?
  feedback   String?   
  isApproved Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  deal    Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pdfFile File? @relation("DealOfferFile", fields: [pdfFileId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([dealId, version])
  @@index([dealId])
  @@index([pdfFileId])
  @@index([validUntil])
}

model DealStageHistory {
  id           String     @id @default(uuid()) 
  dealId       String     
  oldStage     DealStage?
  newStage     DealStage
  changedById  String     
  isException  Boolean    @default(false)
  approvedById String?    
  reason       String?    
  createdAt    DateTime   @default(now())

  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy  User  @relation(fields: [changedById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  approvedBy User? @relation("StageExceptionApprover", fields: [approvedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([dealId])
  @@index([changedById])
  @@index([approvedById])
  @@index([newStage])
  @@index([createdAt])
}

model StockBalance {
  id        String   @id @default(uuid()) 
  productId String   @unique 
  onHand    Float    @default(0)
  reserved  Float    @default(0)
  available Float    @default(0)
  updatedBy String?  
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([available])
}

model StockAdjustment {
  id          String              @id @default(uuid()) 
  productId   String              
  quantity    Float
  type        StockAdjustmentType
  reason      String
  createdById String              
  createdAt   DateTime            @default(now())

  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdById])
  @@index([createdAt])
}

model StockReservation {
  id        String                 @id @default(uuid()) 
  productId String                 
  orderId   String                 
  quantity  Float
  status    StockReservationStatus @default(ACTIVE)
  expiresAt DateTime?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([productId])
  @@index([orderId])
  @@index([orderId, status])
  @@index([status])
  @@index([status, expiresAt])
  @@index([expiresAt])
}

model ExpectedReceipt {
  id           String                @id @default(uuid()) 
  supplierId   String?               
  expectedDate DateTime
  status       ExpectedReceiptStatus @default(PENDING)
  comment      String?               
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  supplier Supplier?             @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items    ExpectedReceiptItem[]

  @@index([supplierId])
  @@index([expectedDate])
  @@index([status])
}

model ExpectedReceiptItem {
  id                String   @id @default(uuid()) 
  expectedReceiptId String   
  productId         String   
  quantity          Float
  receivedQuantity  Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  expectedReceipt ExpectedReceipt @relation(fields: [expectedReceiptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([expectedReceiptId])
  @@index([productId])
}

model Order {
  id              String        @id @default(uuid()) 
  orderNumber     String        @unique
  dealId          String        @unique 
  status          OrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  totalAmount     Decimal       
  paidAmount      Decimal       @default(0) 
  remainingAmount Decimal       
  paymentTerms    String?       
  promisedDate    DateTime?
  deliveryAddress String?
  deletedAt       DateTime?
  version         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  deal         Deal               @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items        OrderItem[]
  payments     Payment[]
  deliveries   Delivery[]
  reservations StockReservation[]

  @@index([dealId])
  @@index([status])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([promisedDate])
  @@index([deletedAt])
}

model OrderItem {
  id                String   @id @default(uuid()) 
  orderId           String   
  productId         String   
  quantity          Float
  reservedQuantity  Float    @default(0)
  deliveredQuantity Float    @default(0)
  unitPrice         Decimal  
  totalPrice        Decimal  
  source            OrderItemSource @default(SKU)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deliveryItems DeliveryItem[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id          String              @id @default(uuid()) 
  orderId     String              
  amount      Decimal             
  currency    String              @default("RUB")
  plannedDate DateTime?
  paymentDate DateTime?
  status      PaymentRecordStatus @default(PENDING)
  comment     String?             
  fileId      String?             
  createdById String              
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file      File? @relation("PaymentFile", fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([orderId])
  @@index([fileId])
  @@index([createdById])
  @@index([plannedDate])
  @@index([paymentDate])
  @@index([status])
}

model Delivery {
  id             String         @id @default(uuid()) 
  orderId        String         
  deliveryDate   DateTime
  recipient      String?
  status         DeliveryStatus @default(PLANNED)
  trackingNumber String?
  comment        String?        
  fileId         String?        
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order Order          @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  file  File?          @relation("DeliveryFile", fields: [fileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items DeliveryItem[]

  @@index([orderId])
  @@index([fileId])
  @@index([deliveryDate])
  @@index([status])
}

model DeliveryItem {
  id          String   @id @default(uuid()) 
  deliveryId  String   
  orderItemId String   
  quantity    Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  delivery  Delivery  @relation(fields: [deliveryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([deliveryId])
  @@index([orderItemId])
}

model Activity {
  id          String       @id @default(uuid()) 
  authorId    String       
  relatedType String
  relatedId   String       
  type        ActivityType
  content     String?      
  metadata    Json?
  createdAt   DateTime     @default(now())

  author User @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([authorId])
  @@index([relatedType, relatedId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) 
  userId     String?  
  action     String
  entityType String
  entityId   String   
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation("AuditLogUser", fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model SalesPlan {
  id           String   @id @default(uuid()) 
  userId       String   
  period       DateTime
  targetAmount Decimal  
  actualAmount Decimal  @default(0) 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, period])
  @@index([period])
}

model LeadPlan {
  id          String   @id @default(uuid()) 
  userId      String   
  period      DateTime
  targetCount Int
  actualCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, period])
  @@index([period])
}

model KpiSetting {
  id                   String   @id @default(uuid()) 
  period               DateTime
  salesPlanWeight      Int      @default(40)
  qualifiedLeadsWeight Int      @default(15)
  conversionWeight     Int      @default(15)
  taskOnTimeWeight     Int      @default(15)
  crmDisciplineWeight  Int      @default(15)
  maxMetricValue       Int      @default(100)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([period])
}

// === P0 Infrastructure ===

model ServiceAccount {
  id          String    @id @default(uuid())
  name        String    @unique
  tokenHash   String    @unique
  permissions Json
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tokenHash])
  @@index([isActive])
}

model InboundWebhookEvent {
  id            String    @id @default(uuid())
  source        String
  externalId    String
  payloadHash   String
  payload       Json?
  attempts      Int       @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  error         String?
  createdAt     DateTime  @default(now())

  @@unique([source, externalId])
  @@index([processedAt])
  @@index([processedAt, createdAt])
}

model TelegramLeadMetadata {
  id                  String    @id @default(uuid())
  leadId              String    @unique
  telegramUserId      String
  telegramUsername    String?
  rawPayload          Json
  isPendingAssignment Boolean   @default(true)
  assignedAt          DateTime?
  escalatedAt         DateTime?
  adminMessageId      String?
  adminChatId         String?
  createdAt           DateTime  @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([telegramUserId])
  @@index([isPendingAssignment])
}

// === Panel Domain ===

model PanelType {
  id            String   @id @default(uuid())
  code          String   @unique
  displayNameRu String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  qualityMappings SupplierQualityMapping[]
  calculationLineItems CalculationLineItem[]
  qualifications       LeadQualification[]
}

model PanelSize {
  id          String  @id @default(uuid())
  widthMm     Int
  heightMm    Int
  areaM2      Decimal @db.Decimal(10, 4)
  displayName String
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  calculationLineItems CalculationLineItem[]
  qualifications       LeadQualification[]

  @@unique([widthMm, heightMm])
}

model PanelThicknessPricing {
  id             String    @id @default(uuid())
  supplierId     String
  qualityClassId String
  thicknessMm    Int
  basePricePerM2 Decimal   @db.Decimal(12, 2)
  currencyCode   String    @default("CNY")
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  isActive       Boolean   @default(true)

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass QualityClass @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, qualityClassId, thicknessMm, isActive, validFrom])
  @@index([supplierId, qualityClassId])
}

model QualityClass {
  id     String @id @default(uuid())
  code   String @unique
  nameRu String

  supplierMappings  SupplierQualityMapping[]
  calculationLineItems CalculationLineItem[]
  thicknessPricings PanelThicknessPricing[]
}

model SupplierQualityMapping {
  id             String  @id @default(uuid())
  supplierId     String
  panelTypeId    String
  qualityClassId String
  isDefault      Boolean @default(false)

  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  panelType    PanelType    @relation(fields: [panelTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass QualityClass @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([supplierId, panelTypeId, qualityClassId])
  @@index([supplierId])
  @@index([panelTypeId])
  @@index([qualityClassId])
}

model PanelColor {
  id                 String   @id @default(uuid())
  supplierId         String
  colorCode          String
  colorName          String
  createdByManagerId String
  createdAt          DateTime @default(now())

  supplier             Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  calculationLineItems CalculationLineItem[]

  @@unique([supplierId, colorCode])
  @@index([supplierId])
}

model SupplierOrder {
  id              String              @id @default(uuid())
  dealId          String              @unique
  supplierId      String
  status          SupplierOrderStatus @default(DRAFT)
  estimatedDate   DateTime?
  deliveryAddress String?
  deliveryCost    Decimal?            @db.Decimal(10, 2)
  trackingNumber  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([supplierId])
  @@index([status])
}

// === Calculation Domain (P1) ===

model CalculationSession {
  id              String    @id @default(uuid())
  leadId          String
  dealId          String?
  clientId        String?
  projectObjectId String?
  createdById     String
  status          String    @default("draft")
  totalAmount     Decimal?  @db.Decimal(12, 2)
  displayCurrency String    @default("USD")
  cnyUsdRate          Decimal? @db.Decimal(18, 8)
  sellingCoefficient  Decimal? @db.Decimal(8, 4)
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  lead      Lead                  @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy User                  @relation("CalculationCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)
  items     CalculationLineItem[]
  panelQuote PanelQuote?

  @@index([leadId, status])
  @@index([createdById])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model CalculationLineItem {
  id             String   @id @default(uuid())
  calculationId  String
  sortOrder      Int      @default(0)
  panelTypeId    String
  panelSizeId    String
  thicknessMm    Int
  supplierId     String
  qualityClassId String
  colorId        String?
  requiredAreaM2     Decimal  @db.Decimal(10, 4)
  sheetsCount        Int
  supplierPricePerM2 Decimal  @db.Decimal(12, 2)
  clientPricePerM2   Decimal  @db.Decimal(12, 2)
  pricePerM2         Decimal  @db.Decimal(12, 2)
  pricePerSheet      Decimal  @db.Decimal(12, 2)
  totalPrice         Decimal  @db.Decimal(12, 2)
  wastePercent   Decimal  @db.Decimal(5, 2)
  createdAt      DateTime @default(now())

  calculation  CalculationSession @relation(fields: [calculationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  panelType    PanelType          @relation(fields: [panelTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  panelSize    PanelSize          @relation(fields: [panelSizeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  supplier     Supplier           @relation(fields: [supplierId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  qualityClass QualityClass       @relation(fields: [qualityClassId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  color        PanelColor?        @relation(fields: [colorId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([calculationId, sortOrder])
}

// === Panel Quote Domain (P2) ===

model PanelQuote {
  id              String   @id @default(uuid())
  calculationId   String   @unique
  leadId          String
  managerId       String
  dealId          String?
  status          String   @default("draft")
  totalAmount     Decimal  @db.Decimal(12, 2)
  displayCurrency String   @default("USD")
  cnyUsdRate          Decimal? @db.Decimal(18, 8)
  sellingCoefficient  Decimal? @db.Decimal(8, 4)
  deliveryCost    Decimal? @db.Decimal(10, 2)
  clientComment   String?
  rejectionReason String?
  validUntil      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  calculation CalculationSession @relation(fields: [calculationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  lead        Lead               @relation(fields: [leadId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  manager     User               @relation("QuoteManager", fields: [managerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  deal        Deal?              @relation(fields: [dealId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items       PanelQuoteItem[]

  @@index([leadId, status])
  @@index([managerId])
  @@index([status, createdAt])
}

model PanelQuoteItem {
  id               String   @id @default(uuid())
  quoteId          String
  panelTypeCode    String
  panelTypeName    String
  panelSizeName    String
  areaM2           Decimal  @db.Decimal(10, 4)
  thicknessMm      Int
  supplierCode     String
  supplierName     String
  qualityClassCode String
  qualityClassName String
  colorCode        String?
  colorName        String?
  requiredAreaM2   Decimal  @db.Decimal(10, 4)
  sheetsCount        Int
  supplierPricePerM2 Decimal  @db.Decimal(12, 2)
  pricePerM2         Decimal  @db.Decimal(12, 2)
  pricePerSheet      Decimal  @db.Decimal(12, 2)
  totalPrice       Decimal  @db.Decimal(12, 2)
  wastePercent     Decimal  @db.Decimal(5, 2)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())

  quote PanelQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([quoteId, sortOrder])
}

// Centralized CNY → USD rate for the HPL selling formula. Not a multi-currency FX subsystem.
model CurrencyRate {
  id            String    @id @default(uuid())
  fromCurrency  String
  toCurrency    String
  rate          Decimal   @db.Decimal(18, 8)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  createdById   String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdBy User @relation("CurrencyRateCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([fromCurrency, toCurrency, effectiveFrom])
  @@index([createdById])
}
