NODE_ENV=development
PORT=3001

# PostgreSQL (dev via docker-compose.dev.yml):
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm_dev"

# Минимум 32 символа каждый (валидируется Zod при старте):
JWT_ACCESS_SECRET="change-me-min-32-chars-random-string"
JWT_REFRESH_SECRET="change-me-min-32-chars-random-string"

# Service account token hashing (минимум 32 символа):
SERVICE_ACCOUNT_TOKEN_PEPPER="change-me-min-32-chars-service-pepper"

# System users (создаются seed; email для lookup в P0 integrations):
LEAD_POOL_USER_EMAIL="lead-pool@hpl.com"
SYSTEM_USER_EMAIL="system@hpl.com"
ADMIN_USER_EMAIL="admin@hpl.com"

# Origin фронтенда для CORS (опционально; localhost:3000/3001 разрешены всегда):
FRONTEND_ORIGIN="http://localhost:3005"
FRONTEND_URL="http://localhost:3005"

# Redis (Bull queues):
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_PASSWORD=""

# Telegram (исходящие сообщения CRM, PR-3):
TELEGRAM_BOT_TOKEN="replace-with-real-token"
# TELEGRAM_ADMIN_CHAT_ID=""
# Личный Telegram ID админа для ЛС с кнопками назначения (@userinfobot):
TELEGRAM_ADMIN_USER_ID="replace-with-real-id"

# SMTP для email-уведомлений (опционально; без SMTP_HOST письма не отправляются):
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="crm@example.com"
# SMTP_PASS="app-password"
# SMTP_FROM="HPL CRM <crm@example.com>"
